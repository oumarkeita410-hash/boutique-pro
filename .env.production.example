# === MOK-Business — configuration PRODUCTION (en ligne) ===
# Copier en « .env » sur le serveur, remplir, puis NE JAMAIS le partager.
# Générer la clé une fois : php artisan key:generate --force

APP_NAME=MOK-Business
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Conakry
# L'adresse en https de votre domaine (obligatoire en https : voir le guide).
APP_URL=https://votre-domaine.com

# --- Base de données MySQL (fournie par l'hébergeur) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mok_business
DB_USERNAME=
DB_PASSWORD=

# --- Sessions / cache / file d'attente ---
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# --- Compte administrateur initial (créé par le seeder, une seule fois) ---
ADMIN_IDENTIFIANT=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=oumarkeita410@gmail.com
ADMIN_TELEPHONE=+224621952252

# --- Boutique ---
BOUTIQUE_EMAIL=oumarkeita410@gmail.com
BOUTIQUE_TELEPHONE=+224621952252
BOUTIQUE_WHATSAPP=+224621952252
SEUIL_DETTE_REPARATEUR=500000

# --- Orange Money (compte personnel : paiement manuel confirmé par l'admin) ---
OM_MODE=manuel
OM_NUMERO=621952252

# --- WhatsApp : bouton wa.me (marche sans rien configurer).
# Pour l'envoi 100% automatique, remplir et mettre WA_ACTIF=true (compte Meta Business requis).
WA_ACTIF=false
