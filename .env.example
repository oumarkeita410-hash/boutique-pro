# === MOK-Business — exemple de configuration ===
# Copier en « .env », remplir, et NE JAMAIS versionner le vrai .env.

APP_NAME=MOK-Business
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Conakry
APP_URL=https://votre-domaine.com

# --- Base de données ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mok_business
DB_USERNAME=
DB_PASSWORD=

# --- Compte administrateur initial (créé par AdminSeeder) ---
ADMIN_IDENTIFIANT=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=oumarkeita410@gmail.com
ADMIN_TELEPHONE=+224621952252

# --- Boutique ---
BOUTIQUE_EMAIL=oumarkeita410@gmail.com
BOUTIQUE_TELEPHONE=+224621952252
BOUTIQUE_WHATSAPP=+224621952252
SEUIL_DETTE_REPARATEUR=500000

# --- Orange Money ---
# Mode "manuel" = compte personnel (le client paie sur OM_NUMERO, l'admin confirme).
# Mode "marchand" = API automatique (nécessite un compte marchand Orange).
OM_MODE=manuel
OM_NUMERO=621952252

# --- Orange Money Guinée (API marchand, seulement si OM_MODE=marchand) ---
# Fournis par Orange lors de l'ouverture du compte marchand. SECRET.
OM_BASE_URL=https://api.orange.com
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
OM_DEVISE=GNF
OM_RETURN_URL=https://votre-domaine.com/paiement/retour
OM_CANCEL_URL=https://votre-domaine.com/paiement/annule
OM_NOTIF_URL=https://votre-domaine.com/api/webhooks/orange-money

# --- Carte bancaire via agrégateur (optionnel) ---
CARTE_FOURNISSEUR=
CARTE_API_KEY=
CARTE_API_SECRET=

# --- Paiement en ligne tout-en-un : CinetPay (Orange Money + MTN + carte) ---
# Fournis dans le tableau de bord CinetPay après ouverture du compte marchand. SECRET.
# Laisser vide = paiement en ligne désactivé (l'app continue de fonctionner).
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_DEVISE=GNF
CINETPAY_CANAUX=ALL
CINETPAY_RETURN_URL=https://votre-domaine.com/app/
CINETPAY_NOTIFY_URL=https://votre-domaine.com/api/webhooks/cinetpay

# --- WhatsApp Business (Meta Cloud API) ---
# WA_ACTIF=true pour activer l'envoi réel. SECRET.
WA_BASE_URL=https://graph.facebook.com/v21.0
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_ACTIF=false

# Important : le compte bancaire (916 507 906) et le numéro Orange Money (621952252)
# ne sont PAS stockés dans l'application. Ils restent sur vos comptes chez l'opérateur
# et la banque. L'application ne fait que DÉCLENCHER les paiements vers votre compte marchand.
